# Production template for an internal Hoppscotch deployment.
#
# Copy to the repo root as `.env` on the SERVER, and use the same file when
# building the desktop client so the two agree on every URL.
#
#   cp deploy/.env.production.example .env
#   $EDITOR .env
#
# Everything below assumes subpath access: one hostname, one port, no
# :3170/:3200 in any URL a person ever types.

#=====================================================================
# 1. THE ONE VALUE TO CHANGE
#=====================================================================
# No scheme, no trailing slash. Every URL below is derived from it.
# HOPP_HOST=apitool.topgun.co.th

#=====================================================================
# 2. Secrets — generate these, do not copy them from here
#=====================================================================
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Exactly 32 characters: openssl rand -hex 16
# BACK THIS UP. Losing it makes every encrypted config value and every
# team vault secret permanently unreadable.
DATA_ENCRYPTION_KEY=

DATABASE_URL=postgresql://postgres:__POSTGRES_PASSWORD__@hoppscotch-db:5432/hoppscotch

#=====================================================================
# 3. Subpath access — one port for everything
#=====================================================================
ENABLE_SUBPATH_BASED_ACCESS=true

VITE_BASE_URL=https://__HOPP_HOST__
VITE_SHORTCODE_BASE_URL=https://__HOPP_HOST__
VITE_ADMIN_URL=https://__HOPP_HOST__/admin
VITE_BACKEND_GQL_URL=https://__HOPP_HOST__/backend/graphql
VITE_BACKEND_WS_URL=wss://__HOPP_HOST__/backend/graphql
VITE_BACKEND_API_URL=https://__HOPP_HOST__/backend/v1

# Exact-match list, no wildcards.
#
# `app://topgunapitool` is the origin of a client built by deploy/build-client.sh:
# it runs the bundle compiled into the binary, and that origin is
# lowercase(productName) from src-tauri/tauri.conf.json. RENAMING THE APP MOVES
# THIS ORIGIN — leave it stale and every request the desktop client makes is
# blocked by CORS, which looks like a workspace that never loads while the app
# itself opens fine.
#
# The __HOPP_HOST_UNDERSCORED__ entries are for a client that connects to this
# server as a remote instance instead: macOS/Linux use
# `app://<host with dots as underscores>`, Windows `http://app.<same>`.
WHITELISTED_ORIGINS=https://__HOPP_HOST__,app://topgunapitool,app://__HOPP_HOST_UNDERSCORED__,http://app.__HOPP_HOST_UNDERSCORED__

# true when the app sits behind a reverse proxy or load balancer
TRUST_PROXY=true

#=====================================================================
# 4. Sign-in
#=====================================================================
# NOTE: VITE_ALLOWED_AUTH_PROVIDERS and the MAILER_* values below are NOT
# read from this file — they are excluded from env sync and can only be set
# through onboarding. `deploy/bootstrap.sh` posts them for you. They are kept
# here so one file documents the whole deployment.
VITE_ALLOWED_AUTH_PROVIDERS=GOOGLE

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://__HOPP_HOST__/backend/v1/auth/google/callback
GOOGLE_SCOPE=email,profile

# Company domains allowed to sign in. LEAVE THIS SET — empty means any Google
# account that reaches the login page can register itself.
# Unlike the two above, this one IS synced from .env on every restart.
GOOGLE_ALLOWED_DOMAINS=

# Needed for team invitation emails. Without it invites are created but no
# mail is sent, and the inviter has to pass the /join-team link by hand.
MAILER_SMTP_ENABLE=true
MAILER_USE_CUSTOM_CONFIGS=true
MAILER_SMTP_HOST=
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURE=false
MAILER_TLS_REJECT_UNAUTHORIZED=true
MAILER_ADDRESS_FROM=

#=====================================================================
# 5. Team secret vault
#=====================================================================
# true shares secret values with every member of a team, VIEWERs included,
# encrypted at rest with DATA_ENCRYPTION_KEY.
TEAM_SECRET_VAULT_ENABLED=true

# Writes are always audited. Turn this on to audit reads too — noisy, since
# loading a workspace fetches every environment.
TEAM_SECRET_VAULT_AUDIT_READS=false

#=====================================================================
# 6. Desktop client
#=====================================================================
# false hides the instance switcher, so the app can only ever talk to this
# server and nobody wanders into Hoppscotch Cloud by accident.
VITE_INSTANCE_SWITCHING_ENABLED=false
